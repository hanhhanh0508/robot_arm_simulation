<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_robot">
  <!-- Load macro UR5e -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur5e_macro.xacro"/>
  <xacro:ur5e_robot prefix="" />

  <!-- Plugin attach/detach cho Gazebo -->
  <gazebo>
     <plugin name="gazebo_ros_link_attacher"
          filename="libgazebo_ros_link_attacher.so"/>
  </gazebo>

</robot>

